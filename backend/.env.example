# Backend configuration for WeatherBuddy AI
# Copy this file to .env and fill in values as needed.

# Secret used to sign JWT auth tokens. Change this in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Stripe (optional) ---
# Leave unset to use the built-in DEV fallback checkout (records the plan in
# the DB but does not charge a card). Set these to go live with real (test)
# card payments.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AI / LLM (optional) ---
# The rule-based AI engine works with NO key. Set one of these to route the
# AI narrative and chat through a real model, with automatic fallback to the
# rule engine if the call fails. Leave both unset to stay 100% rule-based.
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# Optional model override (defaults to claude-opus-5 for Anthropic).
# LLM_MODEL=claude-opus-5

# --- Movies (optional, recommended) ---
# Live now-playing + upcoming lists come from The Movie Database (TMDB).
# Free API key: https://www.themoviedb.org/settings/api  → put the v3 key below.
# Without a key the app shows a built-in curated Tamil list instead.
# TMDB_API_KEY=

# --- Server ---
PORT=5000

# --- SQLite persistence (Railway) ---
# Local dev keeps the DB in backend/data automatically. In production the app
# defaults the DB to /data (see backend/data/db.js) so it lives on a Railway
# Volume. Set DB_DIR to override the directory if needed.
# DB_DIR=/data
